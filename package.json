{
  "name": "mtls-gate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that enforces mTLS on selected hostnames and answers 421 when a connection carries no client certificate",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
